  "dataContract": {
    "goods": [
      "id", "title", "price", "category", "condition",
      "description", "image", "sellerId", "status", "createdAt"
    ],
    "orders": [
      "id", "goodsId", "buyerId", "sellerId",
      "titleSnapshot", "priceSnapshot", "status",
      "createdAt", "completedAt"
    ],
    "favorites": ["userId", "goodsId"],
    "goodsStatus": ["available", "offline", "sold"],
    "orderStatus": ["pending", "completed"],
    "purchase": "同时创建pending订单并将商品设为sold",
    "completion": "仅卖家可将pending订单设为completed",
    "saveFailure": "保存失败不得报告成功",
    "limitations": ["本地模拟", "无取消退款", "无跨设备同步"]
  },
  "collaboration": {
    "platform": "GitHub",
    "branches": ["feat/模块名", "fix/问题名", "docs/主题名"],
    "rules": [
      "按任务建立Issue",
      "从最新main创建分支",
      "PR关联Issue并由至少另一人审阅",
      "M4协调共享store及个人中心",
      "M3与M5协商详情下单入口",
      "合并前通过相关验证",
      "每日更新进度",
      "D5提前集成",
      "不提交依赖目录或凭据"
    ],
    "definitionOfDone": [
      "代码审阅合并",
      "验收通过",
      "文档日志更新",
      "负责人能解释实现"
    ]
  },
  "submission": [
    "完整源码、配置及锁文件",
    "README和项目说明",
    "截图或演示视频",
    "运行构建说明",
    "真实姓名分工",
    "五份个人总结及代码说明",
    "Git记录或开发日志",
    "测试报告及已知问题",
    "参考资料与工具使用说明",
    "最终Git版本标识"
