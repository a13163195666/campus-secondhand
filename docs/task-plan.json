{
  "schemaVersion": "1.0",
  "project": "校园二手交易平台",
  "direction": "Web",
  "source": "《前端开发实训》课程考核说明",
  "assumptions": {
    "teamSize": 5,
    "memberNames": "M1—M5待替换真实姓名",
    "schedule": "建议12个开发工作日，D1由小组确认，最终按教师截止日期调整",
    "progress": "所有任务待验收；已有实现验证通过后可直接关闭"
  },
  "technology": [
    "Vue 3",
    "Vite",
    "Vue Router",
    "Pinia",
    "JavaScript",
    "响应式CSS",
    "Git",
    "ESLint",
    "Prettier"
  ],
  "courseRequirements": [
    "至少3个页面或视图",
    "至少5个有意义的Vue组件",
    "Vue Router页面切换",
    "至少一个表单及表单验证",
    "列表数据处理",
    "搜索、筛选、排序、分页至少两项",
    "至少一次共享状态管理",
    "至少一次持久化或Mock数据",
    "桌面和手机适配",
    "npm install、npm run dev、npm run build可执行",
    "全员参与开发并说明负责代码",
    "阶段验收至少3页和1个完整核心流程"
  ],
  "scope": {
    "pages": ["商品首页", "商品详情", "发布商品", "个人中心", "我的订单"],
    "coreFlow": ["发布", "搜索浏览", "详情", "模拟下单", "卖家确认完成"],
    "data": "Mock与localStorage",
    "identity": "可切换本地演示身份，非真实登录",
    "optional": ["图片上传", "分页", "真实接口"],
    "excluded": ["真实支付", "实时聊天", "物流"]
  },
  "members": [
    {
      "id": "M1",
      "role": "项目负责人",
      "development": "工程、路由、公共布局、集成"
    },
    {
      "id": "M2",
      "role": "需求与原型负责人",
      "development": "首页、搜索、筛选、排序"
    },
    {
      "id": "M3",
      "role": "页面与组件负责人",
      "development": "详情、公共组件、收藏、响应式"
