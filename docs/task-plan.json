    {
      "id": "M4",
      "role": "数据与交互负责人",
      "development": "Pinia、持久化、发布编辑上下架、个人中心"
    },
    {
      "id": "M5",
      "role": "测试、文档与展示负责人",
      "development": "订单与交易状态"
    }
  ],
